{
  "name": "ariadne-desktop",
  "productName": "Ariadne",
  "version": "0.1.0",
  "description": "Ariadne 研究报告助手 · 桌面版",
  "author": "tkzzzzzz6",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "packageManager": "traversal",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.tkzzzzzz6.ariadne",
    "productName": "Ariadne",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist/ariadne-server",
        "to": "server"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Ariadne-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "ariadne"
    },
    "artifactName": "Ariadne-${version}-${os}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tkzzzzzz6/Ariadnian-Agent"
  }
}
